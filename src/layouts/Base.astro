---
import '@fontsource/anton/latin-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import antonUrl from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'services' | 'about' | 'blog' | 'contact';
  /** Thanks page and 404: keep out of search, no canonical. */
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** JSON-LD object(s) for this page. */
  jsonld?: object | object[];
  footerTitle?: string;
  footerText?: string;
  /** Live light ribbon behind the footer heading (homepage only). */
  footerRibbon?: boolean;
  /** Hide the footer's "Start a project" button (on /contact/ itself). */
  footerCta?: boolean;
  backToBlog?: boolean;
}

const {
  title,
  description,
  current,
  noindex = false,
  ogType = 'website',
  jsonld,
  footerTitle = "Let's talk about your next project.",
  footerText = `Tell me about your business and what you want to post. ${site.replyTime}`,
  footerRibbon = false,
  footerCta = true,
  backToBlog = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const nav = [
  { href: '/services/', label: 'Services', key: 'services' },
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/blog/', label: 'Blog', key: 'blog' },
];
const ariaCurrent = (href: string, key: string) =>
  current === key ? (Astro.url.pathname === href ? 'page' : 'true') : undefined;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href={antonUrl} as="font" type="font/woff2" crossorigin />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Dawe Digital logo" />
  <meta name="twitter:card" content="summary_large_image" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="wrap site-header">
    <a class="logo" href="/" aria-label="Dawe Digital home" style="display: block; line-height: 0"><Image src={logo} alt="Dawe Digital" widths={[144, 200, 288, 400]} sizes="(max-width: 1028px) 144px, 200px" loading="eager" /></a>
    <nav class="site-nav" aria-label="Main">
      {nav.map((n) => <a class="navlink" href={n.href} aria-current={ariaCurrent(n.href, n.key)}>{n.label}</a>)}
    </nav>
    <a class="pill pill-pink nav-cta" href="/contact/" aria-current={ariaCurrent('/contact/', 'contact')}>Start a project</a>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer style="border-top: 2px solid #DDB866; position: relative; isolation: isolate">
    {footerRibbon && <canvas class="ribbon" data-ribbon="foot" aria-hidden="true"></canvas>}
    <div class="wrap" style="position: relative; z-index: 1; padding-top: clamp(72px, 8vw, 120px); padding-bottom: 36px; display: grid; gap: 28px">
      <h2 class="display" style="margin: 0; max-width: 16ch; font-size: clamp(52px, 9vw, 144px); line-height: 0.86; text-wrap: balance; text-shadow: 0 0 2px #000, 0 2px 24px rgba(0,0,0,.7)">{footerTitle}</h2>
      <svg class:list={['swoosh', { 'swoosh-rm': footerRibbon }]} aria-hidden="true" viewBox="0 0 600 40"><defs><linearGradient id="sw"><stop offset="0" stop-color="#FF0088"></stop><stop offset=".55" stop-color="#DDB866"></stop><stop offset="1" stop-color="#FDFCF9"></stop></linearGradient></defs><path d="M2 34C180 8 430 2 598 14 430 10 190 20 2 34Z" fill="url(#sw)"></path></svg>
      {footerText && <p style="margin: 8px 0 0; font-size: 19px; line-height: 1.55; color: #D7D7D5; max-width: 52ch">{footerText}</p>}
      <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; margin-top: 8px">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px">
          {footerCta && <a class="pill pill-pink" href="/contact/" style="font-size: 18px; padding: 18px 30px; min-height: 56px">Start a project</a>}
          {backToBlog && (
            <a href="/blog/" style="font-weight: 800; min-height: 44px; display: inline-flex; align-items: center; gap: 10px"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>Back to all posts</a>
          )}
        </div>
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 4px 28px; font-size: 14px; color: #D7D7D5">
          {site.instagram && <a href={`https://www.instagram.com/${site.instagram}/`} rel="me" style="min-height: 44px; display: inline-flex; align-items: center">See my latest work on Instagram</a>}
          <a href="/contact/" style="min-height: 44px; display: inline-flex; align-items: center">Contact</a>
          <a href="/privacy/" style="min-height: 44px; display: inline-flex; align-items: center">Privacy</a>
          <span>Pleasant Grove, UT</span><span>© 2026 Dawe Digital</span>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
