---
import '@fontsource/anton/latin-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'blog';
  footerTitle?: string;
  footerText?: string;
  /** Live light ribbon behind the footer heading (homepage only). */
  footerRibbon?: boolean;
  backToBlog?: boolean;
}

const {
  title,
  description,
  current = 'home',
  footerTitle = "Let's plan your first shoot day.",
  footerText,
  footerRibbon = false,
  backToBlog = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Remove once every [PLACEHOLDER] on the site is filled in. -->
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#000000" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="wrap" style="padding-top: 16px; padding-bottom: 16px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 28px">
    <a class="logo" href="/" aria-label="Dawe Digital home" style="display: block; line-height: 0"><Image src={logo} alt="Dawe Digital" width={400} loading="eager" /></a>
    <nav aria-label="Main" style="display: flex; flex-wrap: wrap; align-items: center; gap: 0 26px; font-weight: 600; font-size: 15px">
      <a class="navlink" href="/#work">Work</a>
      <a class="navlink" href="/#services">Services</a>
      <a class="navlink" href="/#about">About</a>
      <a class="navlink" href="/blog/" aria-current={current === 'blog' ? (Astro.url.pathname === '/blog/' ? 'page' : 'true') : undefined}>Blog</a>
      <a class="pill pill-pink" href="/#contact" style="padding: 12px 22px; min-height: 44px; margin-left: 6px">Start a project</a>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer id="contact" style="border-top: 2px solid #DDB866; position: relative; isolation: isolate">
    {footerRibbon && <canvas class="ribbon" data-ribbon="foot" aria-hidden="true"></canvas>}
    <div class="wrap" style="position: relative; z-index: 1; padding-top: clamp(72px, 8vw, 120px); padding-bottom: 36px; display: grid; gap: 28px">
      <h2 class="display" style="margin: 0; max-width: 16ch; font-size: clamp(52px, 9vw, 144px); line-height: 0.86; text-wrap: balance; text-shadow: 0 0 2px #000, 0 2px 24px rgba(0,0,0,.7)">{footerTitle}</h2>
      <svg class:list={['swoosh', { 'swoosh-rm': footerRibbon }]} aria-hidden="true" viewBox="0 0 600 40"><defs><linearGradient id="sw"><stop offset="0" stop-color="#FF0088"></stop><stop offset=".55" stop-color="#DDB866"></stop><stop offset="1" stop-color="#FDFCF9"></stop></linearGradient></defs><path d="M2 34C180 8 430 2 598 14 430 10 190 20 2 34Z" fill="url(#sw)"></path></svg>
      {footerText && <p style="margin: 8px 0 0; font-size: 19px; line-height: 1.55; color: #D7D7D5; max-width: 52ch">{footerText}</p>}
      <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; margin-top: 8px">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px">
          <a class="pill pill-pink" href="/#contact" style="font-size: 18px; padding: 18px 30px; min-height: 56px">Start a project</a>
          {backToBlog && (
            <a href="/blog/" style="font-weight: 800; min-height: 44px; display: inline-flex; align-items: center; gap: 10px"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>Back to all posts</a>
          )}
        </div>
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 4px 28px; font-size: 14px; color: #D7D7D5">
          <span>@[YOUR INSTAGRAM]</span><span>Pleasant Grove, UT</span><span>© 2026 Dawe Digital</span>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
