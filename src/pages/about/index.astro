---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

const kit = [
  { k: 'Camera', v: 'Canon R8' },
  { k: 'Editing', v: 'DaVinci Resolve and CapCut' },
  { k: 'School', v: 'Social Media Marketing, Ensign College' },
  { k: 'Based in', v: 'Pleasant Grove, Utah' },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${site.url}/about/` },
  ],
};
---
<Base
  title="About Wyatt · Dawe Digital"
  description="Wyatt Dawe runs Dawe Digital, a one-person content studio in Pleasant Grove, Utah, making Reels, photos, and social content."
  current="about"
  jsonld={jsonld}
>
  <section class="wrap" aria-labelledby="about-h" style="padding-top: clamp(48px, 7vw, 104px); padding-bottom: clamp(64px, 8vw, 112px); display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; max-width: 1100px; margin-left: 0">
    <p class="kicker">About</p>
    <h1 id="about-h" class="display" style="margin: 0; font-size: clamp(56px, 8vw, 96px); line-height: 0.88">Hi, I'm <span style="color: #FF0088">Wyatt</span></h1>
    <div style="display: grid; gap: 18px; max-width: 60ch; font-size: 19px; line-height: 1.6; color: #D7D7D5">
      <p style="margin: 0">Dawe Digital is my one-person content studio in Pleasant Grove. I make Reels, photos, and social content for Utah businesses.</p>
      <p style="margin: 0">I plan it, film it, edit it, and hand you posts that are ready to go. You work with me from the first idea to the monthly report. There's no team to hand you off to.</p>
      <p style="margin: 0">I work in medical marketing every day, so I'm used to filming around busy schedules and keeping patient information out of frame.</p>
    </div>
    <dl class="kit">
      {kit.map((i) => (
        <div>
          <dt class="kicker">{i.k}</dt>
          <dd>{i.v}</dd>
        </div>
      ))}
    </dl>
  </section>
</Base>

<style>
  .kit { margin: 16px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 24px 40px; max-width: 1000px; }
  .kit div { border-top: 2px solid #333; padding-top: 16px; display: grid; gap: 10px; }
  .kit dd { margin: 0; font-size: 18px; font-weight: 600; line-height: 1.4; }
</style>
