---
import Base from '../../layouts/Base.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import Steps from '../../components/Steps.astro';
import { site, cities } from '../../data/site';

const faq = [
  { q: 'Where do you work?', a: `I'm based in Pleasant Grove and work with small businesses across Utah County, including ${new Intl.ListFormat('en').format(cities.filter((c) => c !== 'Pleasant Grove'))}.` },
  { q: 'Do I need to be on camera?', a: "No. Some Reels work best with you or your team talking. Others use footage of your space, products, and process. We'll plan what fits." },
  { q: 'What does it cost?', a: "It depends on what you need. Tell me the project, your timing, and any budget, and I'll reply with a proposed scope." },
  { q: 'Do you post the content, or do I?', a: 'If you hire me for social, I post it. For everything else, you get finished files to use however you want.' },
  { q: 'How do we start?', a: `Send me a message through the contact page. ${site.replyTime}` },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services/` },
  ],
};
const h2 = 'margin: 0 0 40px; font-size: clamp(44px, 6vw, 88px); line-height: 0.9';
---
<Base
  title="Video, Photo & Social Media Services in Utah County · Dawe Digital"
  description="Short-form video and Reels, photography, social content management, and website setup for small businesses in Utah County, from Dawe Digital in Pleasant Grove."
  current="services"
  jsonld={jsonld}
>
  <section class="wrap" aria-labelledby="svc-h" style="padding-top: clamp(48px, 7vw, 104px)">
    <p class="kicker" style="margin-bottom: 18px">Services</p>
    <h1 id="svc-h" class="display" style="margin: 0 0 20px; font-size: clamp(56px, 8vw, 96px); line-height: 0.88">What I make</h1>
    <p style="margin: 0 0 48px; font-size: 19px; line-height: 1.55; color: #D9D9D9; max-width: 52ch">Four things for small businesses in Utah County, done by one person from plan to post. Pick one or combine them.</p>
    <h2 class="sr-only">The services</h2>
    <ServiceCards detail />
  </section>

  <section class="wrap" aria-labelledby="how-h" style="padding-top: clamp(80px, 9vw, 128px)">
    <h2 id="how-h" class="display" style={h2}>How it works</h2>
    <Steps />
  </section>

  <section class="wrap" aria-labelledby="faq-h" style="padding-top: clamp(80px, 9vw, 128px); padding-bottom: clamp(48px, 6vw, 80px)">
    <h2 id="faq-h" class="display" style={h2}>Questions</h2>
    <dl class="faq">
      {faq.map((f) => (
        <div>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>
</Base>

<style>
  .faq { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 32px 48px; max-width: 1100px; }
  .faq div { border-top: 2px solid #D9D9D9; padding-top: 18px; }
  .faq dt { font-weight: 800; font-size: 19px; line-height: 1.35; margin-bottom: 8px; }
  .faq dd { margin: 0; font-size: 17px; line-height: 1.55; color: #D9D9D9; }
</style>
