---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog/` },
  ],
};
---
<Base
  title="Blog · Dawe Digital"
  description="Practical posts on planning, filming, and posting content, from Dawe Digital in Pleasant Grove, Utah."
  current="blog"
  jsonld={jsonld}
>
<section aria-labelledby="blog-h" style="max-width: 1440px; margin: 0 auto; padding: clamp(48px, 7vw, 104px) clamp(16px, 4vw, 48px) clamp(40px, 5vw, 64px); display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 64px">
  <h1 id="blog-h" style="margin: 0; flex: 1 1 640px; min-width: 0; font-family: 'Anton', Impact, sans-serif; font-weight: 400; text-transform: uppercase; font-size: clamp(56px, 8vw, 96px); line-height: 0.88; letter-spacing: -0.01em; text-wrap: balance">Notes from behind <span style="color: #FF0088">the camera</span></h1>
  <p style="margin: 0; flex: 0 1 34ch; font-size: 19px; line-height: 1.55; color: #D7D7D5">Practical posts on planning, filming, and posting content.</p>
</section>

<div class="wrap"><div aria-hidden="true" style="height: 2px; background: #DDB866"></div></div>

<section aria-label="Latest post" style="max-width: 1440px; margin: 0 auto; padding: clamp(40px, 5vw, 72px) clamp(16px, 4vw, 48px)">
  <a class="feature paper" href="/blog/batch-film-instagram-reels-medical-clinic/" style="background: #FDFCF9; color: #000; border-radius: 20px; overflow: hidden; text-decoration: none; display: flex; flex-wrap: wrap; align-items: stretch">
    <div aria-hidden="true" style="flex: 1 1 520px; min-width: 0; overflow: hidden; background: #000">
      <div class="media" style="aspect-ratio: 16 / 10; height: 100%; min-height: 280px; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(24px, 3vw, 40px); box-sizing: border-box; color: #FDFCF9">
        <span class="kicker">Reels · How-to</span>
        <span class="display" style="font-size: clamp(88px, 10vw, 160px); line-height: 0.8; color: #FF0088">7 steps</span>
        <span style="display: flex; gap: 6px">
          {[1, 2, 3, 4, 5, 6, 7].map((k) => <span style={`flex: 1; height: 4px; border-radius: 2px; background: ${k <= 3 ? '#FF0088' : '#333333'}`}></span>)}
        </span>
      </div>
    </div>
    <div style="flex: 1 1 440px; min-width: 0; padding: clamp(28px, 4vw, 56px); box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; gap: 20px">
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; font-size: 14px; font-weight: 600; color: #3d3d3b">
        <span style="background: #000; color: #FDFCF9; font-weight: 800; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; padding: 6px 11px; border-radius: 999px">Reels</span>
        <span>6 min read</span>
      </div>
      <h2 style="margin: 0; font-family: 'Anton', Impact, sans-serif; font-weight: 400; text-transform: uppercase; font-size: clamp(36px, 3.6vw, 56px); line-height: 0.95; text-wrap: balance">How to Batch-Film Instagram Reels for a Medical Clinic</h2>
      <p style="margin: 0; font-size: 18px; line-height: 1.6; color: #3d3d3b; max-width: 48ch">Creating Instagram Reels for a medical clinic can be challenging, especially when your providers are busy seeing patients throughout the day…</p>
      <span class="pill pill-pink" style="align-self: flex-start; background: #FF0088; color: #000; font-weight: 800; padding: 14px 24px; border-radius: 999px; min-height: 52px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 10px">Read the article
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </span>
    </div>
  </a>

  <p style="margin: clamp(40px, 5vw, 64px) 0 0; display: flex; align-items: center; gap: 18px; font-size: 16px; color: #D7D7D5">
    <span aria-hidden="true" style="flex: 0 0 48px; height: 2px; background: #DDB866"></span>
    More posts on the way.
  </p>
</section>
</Base>

<style>
.feature{transition:transform .35s cubic-bezier(.2,.8,.2,1)}
.feature .media{transition:transform .5s cubic-bezier(.2,.8,.2,1)}
@media (hover:hover) and (pointer:fine){
 .pill:hover{transform:translateY(-2px)}
 .feature:hover .media{transform:scale(1.02)}
 .feature:hover h2{text-decoration:underline;text-decoration-color:#FF0088;text-decoration-thickness:4px;text-underline-offset:8px}
}
@media (prefers-reduced-motion:reduce){.pill,.feature,.feature .media{transition:none}}
</style>
