---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · Dawe Digital" description="This page doesn't exist." noindex>
  <section class="wrap" style="padding-top: clamp(48px, 7vw, 104px); padding-bottom: clamp(48px, 7vw, 104px); display: grid; gap: 24px">
    <h1 class="display" style="margin: 0; font-size: clamp(56px, 8vw, 96px); line-height: 0.88">This page <span style="color: #EB0352">isn't here.</span></h1>
    <p style="margin: 0; font-size: 19px; line-height: 1.55; color: #D7D7D5">It may have moved, or the link has a typo.</p>
    <div style="display: flex; flex-wrap: wrap; gap: 12px">
      <a class="pill pill-line" href="/" style="padding: 14px 24px; min-height: 52px">Back to the homepage</a>
      <a class="pill pill-line" href="/blog/" style="padding: 14px 24px; min-height: 52px">Read the blog</a>
    </div>
  </section>
</Base>
