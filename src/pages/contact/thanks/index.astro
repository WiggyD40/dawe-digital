---
import Base from '../../../layouts/Base.astro';
import { site } from '../../../data/site';
---
<Base
  title="Thanks · Dawe Digital"
  description="Your message to Dawe Digital was sent."
  current="contact"
  noindex
  footerText=""
  footerCta={false}
>
  <section class="wrap" style="padding-top: clamp(48px, 7vw, 104px); padding-bottom: clamp(64px, 8vw, 112px); display: grid; gap: 24px">
    <h1 class="display" style="margin: 0; font-size: clamp(56px, 8vw, 96px); line-height: 0.88">Got it. <span style="color: #FF0088">Thanks.</span></h1>
    <p style="margin: 0; font-size: 19px; line-height: 1.55; color: #D7D7D5; max-width: 52ch">Your message is in. {site.replyTime}</p>
    <div style="display: flex; flex-wrap: wrap; gap: 12px">
      <a class="pill pill-line" href="/blog/" style="padding: 14px 24px; min-height: 52px">Read the blog</a>
      <a class="pill pill-line" href="/" style="padding: 14px 24px; min-height: 52px">Back to the homepage</a>
    </div>
  </section>
</Base>
