---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${site.url}/contact/` },
  ],
};
---
<Base
  title="Start a project · Dawe Digital"
  description="Tell Dawe Digital about your business and what you want to post. Reels, photos, and social content in Pleasant Grove, Utah."
  current="contact"
  jsonld={jsonld}
  footerTitle="Thanks for thinking of me."
  footerText=""
  footerCta={false}
>
  <section class="wrap" aria-labelledby="contact-h" style="padding-top: clamp(48px, 7vw, 104px); padding-bottom: clamp(64px, 8vw, 112px); display: grid; gap: 28px">
    <p class="kicker">Contact</p>
    <h1 id="contact-h" class="display" style="margin: 0; font-size: clamp(56px, 8vw, 96px); line-height: 0.88">Start a <span style="color: #FF0088">project</span></h1>
    <p style="margin: 0; font-size: 19px; line-height: 1.55; color: #D7D7D5; max-width: 52ch">Tell me about your business and what you want to post. {site.replyTime}</p>

    {site.formUrl && (
      <form class="form" method="post" action={site.formUrl} data-contact>
        <label>Your name<input name="name" autocomplete="name" required maxlength="200" /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required maxlength="320" /></label>
        <label><span>Business name <span class="opt">(optional)</span></span><input name="business" autocomplete="organization" maxlength="200" /></label>
        <label>What do you want to post?<textarea name="message" rows="6" required maxlength="5000"></textarea></label>
        <div class="hp" aria-hidden="true"><label>Leave this empty<input name="contact_me_by_fax_only" tabindex="-1" autocomplete="off" /></label></div>
        <input type="hidden" name="js" value="0" />
        <input type="hidden" name="elapsed" value="" />
        <p class="note">Used only to reply to you. Please don't include patient or health information.</p>
        <button class="pill pill-pink" type="submit">Send</button>
        <p class="status" role="status" data-status></p>
      </form>
    )}

    {site.email && (
      <p style="margin: 0; font-size: 17px; color: #D7D7D5">Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a></p>
    )}
  </section>
</Base>

<style>
  .form { display: grid; gap: 20px; max-width: 640px; }
  .form label { display: grid; gap: 8px; font-weight: 700; font-size: 15px; }
  .opt { font-weight: 400; color: #D7D7D5; }
  .form input, .form textarea { font: 400 17px/1.5 'Inter', system-ui, sans-serif; color: #FDFCF9; background: #000; border: 2px solid #D7D7D5; border-radius: 12px; padding: 12px 14px; min-height: 48px; box-sizing: border-box; width: 100%; }
  .form textarea { resize: vertical; }
  .form input:focus-visible, .form textarea:focus-visible { outline: 3px solid #DDB866; outline-offset: 3px; border-color: #FDFCF9; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .note { margin: 0; font-size: 15px; line-height: 1.5; color: #D7D7D5; }
  .form button { justify-self: start; border: 0; cursor: pointer; font: 800 17px/1 'Inter', system-ui, sans-serif; padding: 16px 32px; min-height: 52px; }
  .form button:disabled { opacity: .6; cursor: progress; }
  .status { margin: 0; min-height: 1.5em; font-size: 16px; color: #FF0088; font-weight: 700; }
</style>

<script>
  // JS path: post in the background and go to the thanks page. Without JS the form posts natively.
  const form = document.querySelector<HTMLFormElement>('form[data-contact]');
  const started = performance.now();
  // Back from the thanks page can restore this page mid-"Sending…"; reset the button.
  addEventListener('pageshow', (e) => {
    const btn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (e.persisted && btn) { btn.disabled = false; btn.textContent = 'Send'; }
  });
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    (form.elements.namedItem('js') as HTMLInputElement).value = '1';
    (form.elements.namedItem('elapsed') as HTMLInputElement).value = String(Math.round(performance.now() - started));
    btn.disabled = true;
    btn.textContent = 'Sending…';
    status.textContent = '';
    try {
      // Plain urlencoded body and no custom headers, so the browser sends no preflight.
      const res = await fetch(form.action, { method: 'POST', body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>) });
      const data = await res.json();
      if (!data.ok) throw new Error('not ok');
      location.assign('/contact/thanks/');
    } catch {
      status.textContent = "That didn't send. Please try again in a minute.";
      btn.disabled = false;
      btn.textContent = 'Send';
    }
  });
</script>
